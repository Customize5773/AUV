<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Two RGB cameras exceed the default 512 KiB SHM segment. Keep UDP for discovery/remote peers. -->
  <transport_descriptors>
    <transport_descriptor><transport_id>auv_shm</transport_id><type>SHM</type><segment_size>16777216</segment_size></transport_descriptor>
    <transport_descriptor><transport_id>auv_udp</transport_id><type>UDPv4</type></transport_descriptor>
  </transport_descriptors>
  <participant profile_name="auv_images" is_default_profile="true">
    <rtps><userTransports><transport_id>auv_shm</transport_id><transport_id>auv_udp</transport_id></userTransports><useBuiltinTransports>false</useBuiltinTransports></rtps>
  </participant>
</profiles>
